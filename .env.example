# Paste the ENTIRE service-account JSON key as ONE line (keep the \n sequences inside private_key)
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"bot@project.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}

# --- Recommended ---
# Random string; Telegram echoes it in a header so only Telegram can hit /webhook
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Public HTTPS base URL (ngrok / Render). If set, webhook is registered automatically on boot.
PUBLIC_URL=https://your-subdomain.ngrok-free.app

# --- Optional ---
